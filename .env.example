# Your store's handle (the part before .shopfa.st) or its st_ id.
SHOPFAST_SHOP=lumenfold
# A private storefront key (sfsk_…) from Settings → Headless & MCP. Server only: never expose it to the browser.
SHOPFAST_STOREFRONT_KEY=sfsk_live_replace_me
# Leave as is, unless you run the API yourself.
SHOPFAST_API_URL=https://api.shopfa.st
# The signing secret of your storefront.updated webhook endpoint (Settings → Developers → Webhooks).
SHOPFAST_WEBHOOK_SECRET=whsec_replace_me
# Where this site is served, for canonical links, Open Graph and the sitemap.
SITE_URL=http://localhost:3000
